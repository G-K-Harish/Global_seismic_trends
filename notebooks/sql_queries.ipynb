# ============================================================
# Q29. Consecutive earthquakes within 50 km and 1 hour
# ============================================================

q29 = """
WITH consecutive_events AS (
    SELECT
        id, time, latitude, longitude, place,
        LEAD(id)        OVER (ORDER BY time) AS next_id,
        LEAD(time)      OVER (ORDER BY time) AS next_time,
        LEAD(latitude)  OVER (ORDER BY time) AS next_latitude,
        LEAD(longitude) OVER (ORDER BY time) AS next_longitude,
        LEAD(place)     OVER (ORDER BY time) AS next_place
    FROM earthquakes
    WHERE type = 'earthquake'
)
SELECT
    id, time, place,
    next_id, next_time, next_place,
    TIMESTAMPDIFF(SECOND, time, next_time) / 3600 AS time_diff_hours,
    ST_Distance_Sphere(
        POINT(longitude, latitude),
        POINT(next_longitude, next_latitude)
    ) / 1000 AS distance_km
FROM consecutive_events
WHERE next_id IS NOT NULL
  AND TIMESTAMPDIFF(SECOND, time, next_time) <= 3600
  AND ST_Distance_Sphere(
        POINT(longitude, latitude),
        POINT(next_longitude, next_latitude)
      ) <= 50000
ORDER BY time;
"""

q29_result = run_query(q29)
print("\nQ29 - Consecutive Earthquakes Within 50 km and 1 Hour")
print(q29_result)


