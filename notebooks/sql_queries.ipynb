# ============================================================
# Q18. Events with high station coverage
# ============================================================

q18 = """
SELECT
    id,
    time,
    place,
    nst,
    mag
FROM earthquakes
WHERE nst > (
    SELECT AVG(nst)
    FROM (
        SELECT
            nst,
            ROW_NUMBER() OVER (ORDER BY nst) AS rn,
            COUNT(*) OVER () AS total_rows
        FROM earthquakes
        WHERE nst IS NOT NULL
    ) AS ordered_nst
    WHERE rn IN (
        FLOOR((total_rows + 1) / 2),
        CEIL((total_rows + 1) / 2)
    )
)
ORDER BY nst DESC;
"""

q18_result = run_query(q18)
print("\nQ18 - Events With High Station Coverage")
print(q18_result)

