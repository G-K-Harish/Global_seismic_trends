# ============================================================

q22 = """
SELECT
    country,
    year,
    month
FROM earthquakes
WHERE type = 'earthquake'
GROUP BY country, year, month
HAVING COUNT(
           CASE
               WHEN depth_category = 'shallow' THEN 1
           END
       ) > 0
   AND COUNT(
           CASE
               WHEN depth_category = 'deep' THEN 1
           END
       ) > 0
ORDER BY country, year, month;
"""

q22_result = run_query(q22)
print("\nQ22 - Countries With Both Shallow and Deep Earthquakes")
print(q22_result)


# ============================================================
# Q23. Year-over-year growth rate
# ============================================================

q23 = """
SELECT
    year,
    eq_count,
    previous_year_count,
    (
        (eq_count - previous_year_count)
        / NULLIF(previous_year_count, 0)
    ) * 100 AS growth_rate
FROM (
    SELECT
        year,
        eq_count,
        LAG(eq_count) OVER (ORDER BY year) AS previous_year_count
    FROM (
        SELECT
            year,
            COUNT(*) AS eq_count
        FROM earthquakes
        WHERE type = 'earthquake'
        GROUP BY year
    ) AS yearly_counts
) AS yearly_growth;
"""

q23_result = run_query(q23)
print("\nQ23 - Year-over-Year Growth")
print(q23_result)


