# ============================================================
# Q16. Number of earthquakes by data type
# ============================================================

q16 = """
SELECT
    jt.data_type,
    COUNT(*) AS earthquake_count
FROM earthquakes AS e
JOIN JSON_TABLE(
    CONCAT(
        '["',
        REPLACE(TRIM(BOTH ',' FROM e.types), ',', '","'),
        '"]'
    ),
    '$[*]' COLUMNS (
        data_type VARCHAR(100) PATH '$'
    )
) AS jt
WHERE e.type = 'earthquake'
GROUP BY jt.data_type
ORDER BY earthquake_count DESC;
"""

q16_result = run_query(q16)
print("\nQ16 - Earthquakes by Data Type")
print(q16_result)


