# ============================================================
# Q26. Countries with highest shallow-to-deep ratio
# ============================================================

q26 = """
SELECT
    country,
    SUM(CASE WHEN depth_category = 'shallow' THEN 1 ELSE 0 END) AS shallow_count,
    SUM(CASE WHEN depth_category = 'deep' THEN 1 ELSE 0 END) AS deep_count,
    SUM(CASE WHEN depth_category = 'shallow' THEN 1 ELSE 0 END)
        / NULLIF(SUM(CASE WHEN depth_category = 'deep' THEN 1 ELSE 0 END), 0) AS shallow_deep_ratio
FROM earthquakes
WHERE type = 'earthquake'
GROUP BY country
HAVING deep_count > 0
ORDER BY shallow_deep_ratio DESC;
"""

q26_result = run_query(q26)
print("\nQ26 - Shallow to Deep Ratio")
print(q26_result)


