import pandas as pd
import requests as rq
from datetime import datetime
import numpy as np


earthquake_records=[]
url = "https://earthquake.usgs.gov/fdsnws/event/1/query"
start_year=datetime.now().year-5
end_year=datetime.now().year

for year in range (start_year, end_year+1):
    for month in range (1,13):
        start_date=f"{year}-{month:02d}-01"
        if (month==12):
            end_date=f"{year+1}-01-01"
        else:
            end_date=f"{year}-{month+1:02d}-01"

        parameters = {
            "format":"geojson",
            "starttime": start_date,
            "endtime": end_date,
            #"minmagnitude": 2
        }

        response = rq.get(url, params = parameters)
        if response.status_code !=200:
            print(f"Failed for {start_date}: {response.text[:200]}")
            continue
        try:
            data = response.json()
        except Exception as e:
            print(f"JSON error for {start_date}: {e}")
            continue

        for feature in data["features"]:
            properties = feature["properties"]
            coordinates = feature["geometry"]["coordinates"]
            earthquake_records.append({
                "id": feature.get("id"),
                "time": pd.to_datetime(properties.get("time"), unit="ms"),
                "updated": pd.to_datetime(properties.get("updated"), unit="ms"),
                "longitude": coordinates[0] if len(coordinates)>0 else None,
                "latitude": coordinates[1] if len(coordinates)>1 else None,
                "depth_km": coordinates[2] if len(coordinates)>2 else None,
                "mag": properties.get("mag"),
                "magType": properties.get("magType"),
                "place" : properties.get("place"),
                "status" : properties.get("status"),
                "tsunami" : properties.get("tsunami"),
                "alert": properties.get("alert"),
                "felt": properties.get("felt"),
                "cdi": properties.get("cdi"),      
                "mmi": properties.get("mmi"), 
                "sig" : properties.get("sig"),
                "net" : properties.get("net"),
                "nst" : properties.get("nst"),
                "dmin" : properties.get("dmin"),
                "rms" : properties.get("rms"),
                "gap" : properties.get("gap"),
                "types" : properties.get("types"),
                "code": properties.get("code"),
                "ids" : properties.get("ids"),
                "sources" : properties.get("sources"),
                "type" : properties.get("type")
            })
df=pd.DataFrame(earthquake_records)


df[["magType", "status", "alert", "net", "types", "sources", "type"]] = df[["magType", "status",  "alert", "net", "types", "sources", "type"]].apply(lambda x : x.str.strip().str.lower())
df["country"] = df["place"].str.extract(r',\s*([^,]+)$')   #() → capture this part      # [^,]+ → the rule for what to capture
df["country"] = df["country"].fillna(df["place"]) # Filling the remaining places without comma as it is


df["nst"] = df["nst"].fillna(df["nst"].median())  #filling numeric values with their corresponding median
df["dmin"] = df["dmin"].fillna(df["dmin"].median())
df["gap"] = df["gap"].fillna(df["gap"].median())
df["rms"] = df["rms"].fillna(df["rms"].median())

df["depth_category"] = np.where(      #derived columns
    df["depth_km"] <= 70,
    "shallow",
    "deep"
)

df["mag_category"] = np.where(
    df["mag"].isna(),
    np.nan,
    np.where(
        df["mag"] < 7,
        "strong",
        "destructive"
    )
)

df["year"] = df["time"].dt.year
df["month"] = df["time"].dt.month
df["day"] = df["time"].dt.day
df["day_of_week"] = df["time"].dt.day_of_week
df["hour"] = df["time"].dt.hour


df.to_csv("earthquakes_cleaned.csv", index=False)
